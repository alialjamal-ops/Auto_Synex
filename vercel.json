{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/demos",
      "destination": "https://auto-synex-demos.vercel.app/demos"
    },
    {
      "source": "/demos/:path*",
      "destination": "https://auto-synex-demos.vercel.app/demos/:path*"
    },
    {
      "source": "/((?!assets/|templates-section.js).*)",
      "destination": "/index.html"
    }
  ]
}
